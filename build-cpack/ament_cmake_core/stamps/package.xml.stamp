<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>serial_modbus_rtu_slavery</name>
  <version>1.0.0</version>
  <description>基于 /dev/ttyTHS1 115200 8N1 的 Modbus RTU slavery 管理：订阅 /led_state/torso(MsgInfoLedCmd) 并下发 LED 数据帧，支持多从站、超时重试与掉站机制</description>
  <maintainer email="137196922@qq.com">nvidia</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>my_interfaces</depend>
  <depend>ament_index_cpp</depend>

  <build_depend>libmodbus</build_depend>
  <exec_depend>libmodbus</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
